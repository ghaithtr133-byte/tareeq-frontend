# Public browser API origin for the separately deployed Backend REST API. Do not include /api/v1.
# Example: https://api.example.com
NEXT_PUBLIC_API_BASE_URL=

# Server-side API origin. Do not include /api/v1. When absent, server requests
# temporarily fall back to NEXT_PUBLIC_API_BASE_URL until a private backend URL is available.
API_BASE_URL=

# Approved public website origin used for canonical URLs and Open Graph URLs.
# Leave empty until the production domain is approved. Example: https://www.example.com
NEXT_PUBLIC_SITE_URL=
