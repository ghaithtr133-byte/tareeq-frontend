# Public browser API origin for the separately deployed Backend REST API. Do not include /api/v1.
# Example: https://api.example.com
NEXT_PUBLIC_API_BASE_URL=

# Server-side API origin. Do not include /api/v1. When absent, server requests
# temporarily fall back to NEXT_PUBLIC_API_BASE_URL until a private backend URL is available.
API_BASE_URL=

# Selects exactly one source for public content. The safe default is `live`.
# Set to `demo` only for an explicitly configured deployment or local review;
# it serves bundled Arabic demo records and never falls back from the live API.
PUBLIC_CONTENT_MODE=live

# Approved public website origin used for canonical URLs and Open Graph URLs.
# Leave empty until the production domain is approved. Example: https://www.example.com
NEXT_PUBLIC_SITE_URL=

# Enables isolated homepage design-review fixtures only in local development or Vercel Preview.
# It is forcibly ignored by Production and unknown deployment environments.
NEXT_PUBLIC_ENABLE_DESIGN_REVIEW_MOCKS=false

# Set only after confirming Vercel Deployment Protection for the Preview deployment.
# This server-only setting permits the fixture disclosure to be hidden in that protected Preview.
TAREEQ_PREVIEW_ACCESS_PROTECTED=false
